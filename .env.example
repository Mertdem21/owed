# Copy to .env and fill in. Every integration is optional - missing keys fall back to local behaviour.
SENSO_API_KEY=
SIE_API_KEY=
ARCEE_API_KEY=
# Optional: pin Arcee model ids (otherwise picked automatically from the live model list)
ARCEE_MODEL_SMALL=
ARCEE_MODEL_LARGE=
AMPLITUDE_API_KEY=
STATSIG_SERVER_SECRET=
# singlestoredb://USER:PASSWORD@HOST:3306/owed  (URL-encode special characters in the password; the database is created if missing)
SINGLESTORE_URL=
# Cognee Cloud: per-tenant URL and tenant id from the API Keys page
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Where the summary email goes (your own address)
OWED_USER_EMAIL=
# Demo date (the demo data is built around this day)
DEMO_TODAY=2026-11-20
AUTO_CLAIM_LIMIT_USD=150
# Real Gmail over IMAP (use a separate test account): app password from myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Which emails Owed may read. This reads the test emails (label "owed") plus real receipts by subject:
GMAIL_QUERY={label:owed subject:order subject:receipt subject:payment subject:delivered} newer_than:120d
